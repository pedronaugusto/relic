{
  "package": "relic",
  "compile_step": "check",
  "targets": [
    "x86_64-linux-gnu",
    "aarch64-linux-gnu",
    "x86_64-linux-musl",
    "x86_64-windows-gnu",
    "aarch64-windows-gnu",
    "x86_64-macos",
    "aarch64-macos"
  ],
  "compile_once": false,
  "test_timeout": "--test-timeout 60s",
  "sanitizer": "test",
  "setup_step": "ci-setup",
  "test_job_timeout": 30,
  "windows_job_timeout": 45,
  "sanitizer_job_timeout": 30,
  "source_job_timeout": 10,
  "shards": { "windows": 5, "macos": 3 },
  "fast_shards": 6
}
