{
  "compile_step": "check",
  "targets": [
    "x86_64-linux-gnu",
    "aarch64-linux-gnu",
    "x86_64-linux-musl",
    "x86_64-windows-gnu",
    "aarch64-windows-gnu",
    "x86_64-macos",
    "aarch64-macos"
  ],
  "setup_step": "ci-setup",
  "test_job_timeout": 60,
  "windows_job_timeout": 60,
  "source_job_timeout": 10,
  "cross_job_timeout": 30,
  "fast_shards": 2,
  "shards": {
    "linux": 2,
    "macos": 3,
    "windows": 6,
    "linux_arm": 2,
    "windows_arm": 8
  },
  "git": {
    "version": "2.56.0",
    "sha256": "26c56c296b38c0695b26fa95f475f1d01704d2d38e73465ca30b0b2f5dc789d3",
    "windows": {
      "x86_64": "eceb5e061aa90df2f69ddd3e90f0030e1b8037a7829934bc40e4be1caa1accc1",
      "aarch64": "edd9bd32aefa5d2bd4b938c38c18ceca306a7f6b29a6951cd6a4bb16d9d28d8f"
    }
  },
  "jobs": [
    {
      "name": "ThreadSanitizer (Linux)",
      "step": "test",
      "args": ["-Dci-tsan=true", "-Doptimize=debug", "-Dci-lint=false", "-Dci-timings=true"],
      "tiers": ["release"],
      "timeout": 30,
      "shards": 8
    },
    {
      "name": "Objects past 4 GiB (Linux)",
      "step": "test",
      "args": ["-Doptimize=safe", "-Dci-lint=false", "-Dlarge-objects=true", "-Dtest-filter=GiB"],
      "tiers": ["release"],
      "timeout": 45
    }
  ]
}
