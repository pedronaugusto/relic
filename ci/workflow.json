{
  "compile_step": "check",
  "targets": [
    "x86_64-linux-gnu",
    "aarch64-linux-gnu",
    "x86_64-linux-musl",
    "x86_64-windows-gnu",
    "aarch64-windows-gnu",
    "x86_64-macos",
    "aarch64-macos"
  ],
  "compile_once": false,
  "setup_step": "ci-setup",
  "test_job_timeout": 60,
  "windows_job_timeout": 60,
  "source_job_timeout": 10,
  "cross_job_timeout": 30,
  "fast_shards": 2,
  "shards": {
    "linux": 2,
    "macos": 3,
    "windows": 6,
    "linux_arm": 2,
    "windows_arm": 8
  },
  "git": {
    "version": "2.56.0",
    "sha256": "26c56c296b38c0695b26fa95f475f1d01704d2d38e73465ca30b0b2f5dc789d3",
    "windows": {
      "x86_64": "bfe94e7b419b16eee9fecbd1253a98e3d4f49ba8f029630549052278ffe286a6",
      "aarch64": "c130c04301d06995ef08f1cbd895342844d1fbb3312f5d32cb27cc05b4b394dc"
    }
  },
  "configurations": [
    {"name": "default", "options": {"http": true, "lfs": true}},
    {"name": "no-http", "options": {"http": false, "lfs": true}},
    {"name": "no-lfs", "options": {"http": true, "lfs": false}, "modules": ["relic"]},
    {"name": "neither", "options": {"http": false, "lfs": false}, "modules": ["relic"]}
  ],
  "jobs": [
    {
      "name": "ThreadSanitizer (Linux)",
      "step": "test",
      "args": ["-Dci-tsan=true", "-Doptimize=debug", "-Dci-lint=false", "-Dci-timings=true"],
      "tiers": ["release"],
      "timeout": 30,
      "shards": 8
    },
    {
      "name": "Objects past 4 GiB (Linux)",
      "step": "test",
      "args": ["-Doptimize=safe", "-Dci-lint=false", "-Dlarge-objects=true", "-Dtest-filter=GiB"],
      "tiers": ["release"],
      "timeout": 45
    }
  ]
}
