{
  "compile_step": "check",
  "targets": [
    "x86_64-linux-gnu",
    "aarch64-linux-gnu",
    "x86_64-linux-musl",
    "x86_64-windows-gnu",
    "aarch64-windows-gnu",
    "x86_64-macos",
    "aarch64-macos"
  ],
  "compile_once": false,
  "setup_step": "ci-setup",
  "test_job_timeout": 45,
  "windows_job_timeout": 60,
  "source_job_timeout": 10,
  "fast_shards": 2,
  "shards": {
    "macos": 3,
    "windows": 6,
    "linux_arm": 2,
    "windows_arm": 8
  },
  "windows_git_latest": true,
  "jobs": [
    {
      "name": "ThreadSanitizer (Linux)",
      "step": "test",
      "args": ["-Dci-tsan=true", "-Doptimize=debug", "-Dci-lint=false", "-Dci-timings=true"],
      "tiers": ["release"],
      "timeout": 30,
      "shards": 8
    },
    {
      "name": "Objects past 4 GiB (Linux)",
      "step": "test",
      "args": ["-Doptimize=safe", "-Dci-lint=false", "-Dlarge-objects=true", "-Dtest-filter=GiB"],
      "tiers": ["release"],
      "timeout": 45
    }
  ]
}
